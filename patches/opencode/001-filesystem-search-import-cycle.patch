--- /dev/null
+++ b/packages/core/test/filesystem-search-import.test.ts
@@ -0,0 +1,40 @@
+import { expect, test } from "bun:test"
+import path from "path"
+import { pathToFileURL } from "url"
+import { tmpdir } from "./fixture/tmpdir"
+
+test("search-first imports leave the FileSystem layer graph fully initialized", async () => {
+  await using tmp = await tmpdir()
+  const core = path.resolve(import.meta.dir, "../src")
+  const source = `
+    await import(${JSON.stringify(pathToFileURL(path.join(core, "filesystem/search.ts")).href)});
+    const { FileSystem } = await import(${JSON.stringify(pathToFileURL(path.join(core, "filesystem.ts")).href)});
+    const seen = new Set();
+    function visit(node, parent) {
+      if (!node) throw new Error("Uninitialized dependency of " + parent);
+      if (seen.has(node)) return;
+      seen.add(node);
+      for (const child of node.dependencies) visit(child, node.name);
+    }
+    visit(FileSystem.node, "root");
+    console.log("complete");
+  `
+  const result = Bun.spawn([process.execPath, "--eval", source], {
+    cwd: path.resolve(import.meta.dir, ".."),
+    env: {
+      ...process.env,
+      XDG_DATA_HOME: path.join(tmp.path, "data"),
+      XDG_CONFIG_HOME: path.join(tmp.path, "config"),
+      XDG_CACHE_HOME: path.join(tmp.path, "cache"),
+      XDG_STATE_HOME: path.join(tmp.path, "state"),
+      OPENCODE_TEST_HOME: tmp.path,
+      OPENCODE_DISABLE_MODELS_FETCH: "1",
+    },
+    stdout: "pipe", stderr: "pipe",
+  })
+  const [out, error, status] = await Promise.all([
+    new Response(result.stdout).text(), new Response(result.stderr).text(), result.exited,
+  ])
+  expect({ status, error }).toEqual({ status: 0, error: "" })
+  expect(out.trim()).toBe("complete")
+})
