+
+  // A portable launcher may bind a fixed drive letter to a different physical root
+  // on each host. Call after canonicalization so outside symlink targets stay outside.
+  export function portablePath(p: string): string {
+    const root = process.env.OPENCODE_PORTABLE_ROOT
+    if (process.platform !== "win32" || !root) return p
+    if (!/^[D-Z]:[\\/]$/i.test(root)) throw new Error("OPENCODE_PORTABLE_ROOT must be an absolute drive root")
+    const physical = realpathSync.native(root)
+    if (!contains(physical, p)) return p
+    return join(root[0].toUpperCase() + ":\\", relative(physical, p))
+  }
 }
